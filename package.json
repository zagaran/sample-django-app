{
  "name": "sample-django-app",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "dependencies": {
    "@babel/plugin-transform-react-jsx": "~7.16.7",
    "@vitejs/plugin-vue": "^6.0.3",
    "bootstrap": "^5.1.1",
    "bootstrap-icons": "^1.13.1",
    "django-react-loader": "^0.1.7",
    "nwb": "^0.24.7",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "rollup-plugin-external-globals": "^0.13.0",
    "vite": "^7.3.6",
    "vue": "^3.5.27",
    "webpack-bundle-tracker": "^0.4.3"
  },
  "scripts": {
    "vite:dev": "vite build --watch --mode development",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "django:dev": "uv run manage.py runserver_plus 8500",
    "celery:dev": "docker compose up -d && uv run celery -A config worker --beat --scheduler redbeat.RedBeatScheduler --loglevel=INFO -Q celery,file_downloads",
    "flower:dev": "uv run celery -A config flower --port=5555"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vue/language-server": "^3.2.5",
    "@vue/typescript-plugin": "^3.2.5",
    "typescript-language-server": "^5.1.3"
  }
}
